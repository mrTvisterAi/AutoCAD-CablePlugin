<UserControl x:Class="CablePlugin.UI.Views.CablePropertiesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F7F7">
  <UserControl.Resources>
    <Style TargetType="TextBlock" x:Key="Lbl">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,2,6,2"/>
      <Setter Property="Foreground" Value="#333"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="3,2"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinWidth" Value="70"/>
    </Style>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </UserControl.Resources>

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#E8F0FE" CornerRadius="3" Padding="8,5" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Handle, StringFormat=Handle: {0}}" Foreground="#666" FontSize="10"
                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"/>
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="1" Text="Нет выбранной кабельной линии."
               VerticalAlignment="Center" HorizontalAlignment="Center"
               Foreground="#888"
               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <GroupBox Header="Идентификация" Padding="6" Margin="0,0,0,6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Группа" Style="{StaticResource Lbl}" Grid.Row="0" Grid.Column="0"/>
            <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
            <TextBlock Text="От" Style="{StaticResource Lbl}" Grid.Row="1" Grid.Column="0"/>
            <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Text="До" Style="{StaticResource Lbl}" Grid.Row="2" Grid.Column="0"/>
            <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="Кабель" Padding="6" Margin="0,0,0,6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Марка" Style="{StaticResource Lbl}" Grid.Row="0"/>
            <TextBox Text="{Binding Mark, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
            <TextBlock Text="Жилы" Style="{StaticResource Lbl}" Grid.Row="1"/>
            <TextBox Text="{Binding Cores, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Text="Сечение" Style="{StaticResource Lbl}" Grid.Row="2"/>
            <TextBox Text="{Binding Section, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>
            <TextBlock Text="Кол-во" Style="{StaticResource Lbl}" Grid.Row="3"/>
            <TextBox Text="{Binding CableCount, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="Длина" Padding="6" Margin="0,0,0,6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="Запас %" Style="{StaticResource Lbl}" Grid.Row="0"/>
            <TextBox Text="{Binding ReservePercent, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
            <TextBlock Text="Доп., м" Style="{StaticResource Lbl}" Grid.Row="1"/>
            <TextBox Text="{Binding AdditionalLength, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Text="Масштаб" Style="{StaticResource Lbl}" Grid.Row="2"/>
            <TextBox Text="{Binding ScaleFactor, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>
            <TextBlock Text="Округл." Style="{StaticResource Lbl}" Grid.Row="3"/>
            <TextBox Text="{Binding RoundUpTo, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1"/>
            <TextBlock Text="Геом." Style="{StaticResource Lbl}" Grid.Row="4"/>
            <TextBlock Text="{Binding GeometricLength, StringFormat={}{0:0.###} м}" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/>
            <TextBlock Text="Итого" Style="{StaticResource Lbl}" Grid.Row="5" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding TotalLength, StringFormat={}{0:0.###} м}" Grid.Row="5" Grid.Column="1"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="Электрика" Padding="6" Margin="0,0,0,6">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="P, кВт" Style="{StaticResource Lbl}" Grid.Row="0"/>
            <TextBox Text="{Binding PowerKw, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>
            <TextBlock Text="cos φ" Style="{StaticResource Lbl}" Grid.Row="1"/>
            <TextBox Text="{Binding CosPhi, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Text="U, В" Style="{StaticResource Lbl}" Grid.Row="2"/>
            <TextBox Text="{Binding Voltage, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>
            <TextBlock Text="Фазы" Style="{StaticResource Lbl}" Grid.Row="3"/>
            <TextBox Text="{Binding Phases, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1"/>
            <TextBlock Text="I, А" Style="{StaticResource Lbl}" Grid.Row="4"/>
            <TextBlock Text="{Binding Current, StringFormat={}{0:0.##}}" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/>
            <TextBlock Text="ΔU, %" Style="{StaticResource Lbl}" Grid.Row="5"/>
            <TextBlock Text="{Binding VoltageDropPercent, StringFormat={}{0:0.##}}" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center"/>
            <TextBlock Text="АВ" Style="{StaticResource Lbl}" Grid.Row="6"/>
            <TextBlock Text="{Binding RecommendedBreaker}" Grid.Row="6" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="Участки прокладки" Padding="6" Margin="0,0,0,6">
          <DataGrid ItemsSource="{Binding Segments}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    HeadersVisibility="Column"
                    MaxHeight="140"
                    FontSize="11"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Способ" Binding="{Binding LayingMethod, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
              <DataGridTextColumn Header="L, м" Binding="{Binding Length, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
              <DataGridTextColumn Header="∅" Binding="{Binding PipeDiameter, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
            </DataGrid.Columns>
          </DataGrid>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
      <Button Content="Пересчёт" Command="{Binding RecalcCommand}"/>
      <Button Content="Полный…" Command="{Binding EditFullCommand}"/>
      <Button Content="Применить" Command="{Binding ApplyCommand}" FontWeight="SemiBold"/>
    </StackPanel>

    <TextBlock Grid.Row="3" Margin="0,6,0,0" FontSize="10" Foreground="#888"
               Text="Изменения пишутся на объект после «Применить»."/>
  </Grid>
</UserControl>
