<Window x:Class="CablePlugin.UI.Views.EditCableLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CablePlugin.UI.Converters"
        Title="Кабельная линия"
        Height="640" Width="820"
        MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
  <Window.Resources>
    <conv:FlexibleDoubleConverter x:Key="DblConv"/>
    <conv:FlexibleNullableDoubleConverter x:Key="NullDblConv"/>
    <Style TargetType="TextBlock" x:Key="Label">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Foreground" Value="#333"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="MinWidth" Value="90"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <GroupBox Header="Идентификация" Grid.Row="0" Margin="0,0,0,8" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Группа:" Style="{StaticResource Label}" Grid.Column="0"/>
        <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,2,12,2"/>
        <TextBlock Text="От:" Style="{StaticResource Label}" Grid.Column="2"/>
        <TextBox Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" Grid.Column="3" Margin="0,2,12,2"/>
        <TextBlock Text="До:" Style="{StaticResource Label}" Grid.Column="4"/>
        <TextBox Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" Grid.Column="5"/>
      </Grid>
    </GroupBox>

    <GroupBox Header="Кабель" Grid.Row="1" Margin="0,0,0,8" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Марка:" Style="{StaticResource Label}" Grid.Column="0"/>
        <TextBox Text="{Binding Mark, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Margin="0,2,12,2"/>
        <TextBlock Text="Жилы:" Style="{StaticResource Label}" Grid.Column="2"/>
        <TextBox Text="{Binding Cores, UpdateSourceTrigger=PropertyChanged}" Grid.Column="3" Margin="0,2,12,2"/>
        <TextBlock Text="Сечение:" Style="{StaticResource Label}" Grid.Column="4"/>
        <TextBox Text="{Binding Section, Converter={StaticResource DblConv}, UpdateSourceTrigger=PropertyChanged}" Grid.Column="5" Margin="0,2,12,2"/>
        <TextBlock Text="Кол-во:" Style="{StaticResource Label}" Grid.Column="6"/>
        <TextBox Text="{Binding CableCount, UpdateSourceTrigger=PropertyChanged}" Grid.Column="7"/>
      </Grid>
    </GroupBox>

    <GroupBox Header="Участки прокладки" Grid.Row="2" Margin="0,0,0,8" Padding="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid ItemsSource="{Binding Segments}"
                  SelectedItem="{Binding SelectedSegment}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FAFAFA"
                  SelectionMode="Single"
                  Margin="0,0,0,8">
          <DataGrid.Columns>
            <!-- ComboBox через Template — иначе ItemsSource на колонке не видит LayingMethods -->
            <DataGridTemplateColumn Header="Способ прокладки" Width="160">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding LayingMethod}" VerticalAlignment="Center" Margin="4,0"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
              <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                  <ComboBox IsEditable="True"
                            IsTextSearchEnabled="True"
                            ItemsSource="{Binding DataContext.LayingMethods, RelativeSource={RelativeSource AncestorType=Window}}"
                            Text="{Binding LayingMethod, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding LayingMethod, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellEditingTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Длина, м"
                                Binding="{Binding Length, Converter={StaticResource DblConv}, UpdateSourceTrigger=PropertyChanged}"
                                Width="90"/>
            <DataGridTextColumn Header="∅ трубы, мм"
                                Binding="{Binding PipeDiameter, Converter={StaticResource NullDblConv}, UpdateSourceTrigger=PropertyChanged}"
                                Width="100"/>
            <DataGridCheckBoxColumn Header="Авто ∅" Binding="{Binding IsPipeDiameterAuto, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
            <DataGridTextColumn Header="Примечание" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Grid.Row="1">
          <Button Content="Добавить участок" Command="{Binding AddSegmentCommand}"/>
          <Button Content="Удалить" Command="{Binding RemoveSegmentCommand}"/>
          <Button Content="Автоподбор трубы" Command="{Binding AutoPipeCommand}"/>
        </StackPanel>
      </Grid>
    </GroupBox>

    <Grid Grid.Row="3" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <GroupBox Header="Длина" Grid.Column="0" Margin="0,0,6,0" Padding="8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="Запас, %:" Style="{StaticResource Label}" Grid.Row="0" Grid.Column="0"/>
          <TextBox Text="{Binding ReservePercent, Converter={StaticResource DblConv}, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,2,12,2"/>
          <TextBlock Text="Доп. длина, м:" Style="{StaticResource Label}" Grid.Row="0" Grid.Column="2"/>
          <TextBox Text="{Binding AdditionalLength, Converter={StaticResource DblConv}, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="3"/>

          <TextBlock Text="Масштаб:" Style="{StaticResource Label}" Grid.Row="1" Grid.Column="0"/>
          <TextBox Text="{Binding ScaleFactor, Converter={StaticResource DblConv}, UpdateSourceTrigger=PropertyChanged}"
                  Grid.Row="1" Grid.Column="1" Margin="0,2,12,2"
                  ToolTip="Можно 0.1, 0.01, 0,001 (точка или запятая)"/>
          <TextBlock Text="Округление до:" Style="{StaticResource Label}" Grid.Row="1" Grid.Column="2"/>
          <TextBox Text="{Binding RoundUpTo, Converter={StaticResource DblConv}, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="3"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,8,0,0"
                     FontWeight="SemiBold"
                     Text="{Binding TotalLength, StringFormat='Итоговая длина: {0:0.###} м'}"/>
        </Grid>
      </GroupBox>

      <GroupBox Header="Электрика" Grid.Column="1" Margin="6,0,0,0" Padding="8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="P, кВт:" Style="{StaticResource Label}" Grid.Row="0" Grid.Column="0"/>
          <TextBox Text="{Binding PowerKw, Converter={StaticResource NullDblConv}, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" Margin="0,2,12,2"/>
          <TextBlock Text="cos φ:" Style="{StaticResource Label}" Grid.Row="0" Grid.Column="2"/>
          <TextBox Text="{Binding CosPhi, Converter={StaticResource DblConv}, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="3"/>

          <TextBlock Text="U, В:" Style="{StaticResource Label}" Grid.Row="1" Grid.Column="0"/>
          <TextBox Text="{Binding Voltage, Converter={StaticResource DblConv}, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Margin="0,2,12,2"/>
          <TextBlock Text="Фазы:" Style="{StaticResource Label}" Grid.Row="1" Grid.Column="2"/>
          <TextBox Text="{Binding Phases, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="3"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                     Text="{Binding Current, StringFormat='I = {0:0.##} А'}"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                     HorizontalAlignment="Right"
                     Text="{Binding VoltageDropPercent, StringFormat='ΔU = {0:0.##} %'}"/>
        </Grid>
      </GroupBox>
    </Grid>

    <Border Grid.Row="4" Background="#E8F0FE" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
      <TextBlock FontSize="13">
        <Run FontWeight="SemiBold" Text="Расчёт: "/>
        <Run Text="{Binding TotalLength, Mode=OneWay, StringFormat='L={0:0.###} м; '}"/>
        <Run Text="{Binding Current, Mode=OneWay, StringFormat='I={0:0.##} А; '}"/>
        <Run Text="{Binding VoltageDropPercent, Mode=OneWay, StringFormat='ΔU={0:0.##}%; '}"/>
        <Run Text="АВ "/>
        <Run FontWeight="SemiBold" Text="{Binding RecommendedBreaker, Mode=OneWay}"/>
      </TextBlock>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="5">
      <Button Content="Пересчитать" Command="{Binding RecalculateCommand}"/>
      <Button Content="OK" IsDefault="True" Command="{Binding OkCommand}" FontWeight="SemiBold"/>
      <Button Content="Отмена" IsCancel="True" Command="{Binding CancelCommand}"/>
    </StackPanel>
  </Grid>
</Window>
